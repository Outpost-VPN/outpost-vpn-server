map $http_upgrade $outpost_connection {
    default upgrade;
    '' close;
}

server_tokens off;
limit_req_zone $binary_remote_addr zone=outpost_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=outpost_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=outpost_ip_setup:10m rate=10r/m;

# Keep the short-lived IP certificate renewable after setup, but do not expose
# the panel, setup mutations, subscriptions, or transports on the IP edge.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/outpost-acme;
    }

    location = / {
        return 301 https://__PUBLIC_IP__/;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/outpost-acme;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name __PUBLIC_IP__ _;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:OUTPOST_IP_TLS:2m;
    client_max_body_size 64k;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/javascript text/javascript application/json text/css;
    proxy_http_version 1.1;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location /.well-known/acme-challenge/ {
        root /var/www/outpost-acme;
    }

    location = / {
        if ($request_method != GET) { return 421; }
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface setup;
    }

    location = /api/v1/setup {
        limit_req zone=outpost_ip_setup burst=10 nodelay;
        if ($request_method != GET) { return 421; }
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface setup;
    }

    location = /app.js {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /assets/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /vendor/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ~ ^/brand-mark(?:-success)?\.png$ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location / {
        return 421;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:OUTPOST_TLS:10m;
    ssl_session_timeout 1d;
    client_max_body_size 1m;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/javascript text/javascript application/json text/css;
    # Bun corrupts streamed responses to HTTP/1.0 upstream requests by appending
    # request framing bytes. Keep every application-edge proxy hop on HTTP/1.1.
    proxy_http_version 1.1;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # The Hysteria auth backend is localhost-only. Never route it from the public edge.
    location ^~ /internal/ {
        access_log off;
        return 404;
    }

    # XHTTP query strings may contain padding and must never enter logs.
    location __XHTTP_PATH__ {
        access_log off;
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
    }

    # The random gRPC service path is a credential-adjacent transport secret.
    location ^~ /__GRPC_SERVICE__/ {
        access_log off;
        grpc_pass grpc://127.0.0.1:10001;
        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
        grpc_set_header Host __DOMAIN__;
        grpc_set_header X-Real-IP $remote_addr;
    }

    # Subscription URLs carry bearer secrets.
    location ^~ /s/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        client_max_body_size 128k;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
    }

    location ^~ /api/v1/auth/ {
        limit_req zone=outpost_auth burst=10 nodelay;
        client_max_body_size 64k;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
    }

    location = /api/v1/dashboard/events {
        limit_req zone=outpost_api burst=40 nodelay;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
        proxy_set_header Connection "";
    }

    # Initial setup is finalized through the IP vhost. Never allow a second
    # domain mutation during the delayed control-plane restart.
    location = /api/v1/setup/domain {
        return 404;
    }

    # A restore is available only during the one-hour first-claim handoff on a
    # clean installation. The archive and claim token are never access-logged.
    location = /api/v1/setup/restore {
        limit_req zone=outpost_auth burst=3 nodelay;
        client_max_body_size 256m;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_read_timeout 4m;
        proxy_send_timeout 4m;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
    }

    # A signed release is about 85 MiB and may take longer than the default
    # upstream timeout on a small VPS. The control plane still enforces its own
    # download deadlines and size limits.
    location = /api/v1/updates/prepare {
        limit_req zone=outpost_api burst=40 nodelay;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_read_timeout 5m;
        proxy_send_timeout 5m;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
    }

    location ^~ /api/v1/ {
        limit_req zone=outpost_api burst=40 nodelay;
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $outpost_connection;
    }

    location ~ ^/(admin|app\.js|vendor/) {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface app;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $outpost_connection;
    }

    # Everything else is the neutral cover page from Outpost. Force the ordinary
    # surface so a client-supplied setup marker cannot select the setup SPA.
    location / {
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Outpost-Surface app;
    }
}
