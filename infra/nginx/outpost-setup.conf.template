server_tokens off;
limit_req_zone $binary_remote_addr zone=outpost_setup:10m rate=10r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/outpost-acme;
    }

    location / {
        return 301 https://__PUBLIC_IP__$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:OUTPOST_SETUP_TLS:2m;
    client_max_body_size 64k;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/javascript text/javascript application/json text/css;
    # Bun corrupts streamed responses to HTTP/1.0 upstream requests by appending
    # request framing bytes. Keep every setup-edge proxy hop on HTTP/1.1.
    proxy_http_version 1.1;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = / {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface setup;
    }

    location = /api/v1/setup {
        limit_req zone=outpost_setup burst=10 nodelay;
        limit_except GET { deny all; }
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface setup;
    }

    location = /api/v1/setup/domain {
        limit_req zone=outpost_setup burst=10 nodelay;
        limit_except POST { deny all; }
        access_log off;
        proxy_pass http://127.0.0.1:8181;
        proxy_set_header Host __PUBLIC_IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Outpost-Surface setup;
    }

    location = /app.js {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /assets/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ^~ /vendor/ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location ~ ^/brand-mark(?:-success)?\.png$ {
        access_log off;
        proxy_pass http://127.0.0.1:8181;
    }

    location / {
        return 404;
    }
}
