[Unit]
Description=Outpost privileged agent
After=network.target

[Service]
Type=simple
User=root
Group=outpost
ExecStart=/opt/outpost/current/bin/outpost-agent
Restart=on-failure
RestartSec=3
RuntimeDirectory=outpost
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/outpost /etc/systemd/system /var/lib/outpost /opt/outpost /run/outpost

[Install]
WantedBy=multi-user.target
