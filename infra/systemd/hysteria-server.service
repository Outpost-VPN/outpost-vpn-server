[Unit]
Description=Outpost Hysteria 2
After=network-online.target outpost.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/outpost/engines/hysteria/current/hysteria server --config /etc/outpost/engines/hysteria.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/outpost /etc/letsencrypt /opt/outpost/engines

[Install]
WantedBy=multi-user.target
