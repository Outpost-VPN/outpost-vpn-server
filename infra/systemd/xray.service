[Unit]
Description=Outpost Xray
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=outpost
Group=outpost
ExecStart=/opt/outpost/engines/xray/current/xray run -config /etc/outpost/engines/xray.json
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/outpost /opt/outpost/engines

[Install]
WantedBy=multi-user.target
