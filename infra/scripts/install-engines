#!/usr/bin/env bash
set -euo pipefail
test "$(id -u)" -eq 0 || { echo "Run as root" >&2; exit 1; }
# Versions, download URLs and SHA-256 pins share the agent/application catalog.
while IFS= read -r engine; do
  mapfile -t info < <(/opt/outpost/current/bin/outpostctl engine-info "$engine")
  /opt/outpost/current/infra/scripts/update-engine "$engine" "${info[4]}" "${info[5]}" install-only
done < <(/opt/outpost/current/bin/outpostctl engine-list)
