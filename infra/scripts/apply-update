#!/usr/bin/env bash
set -euo pipefail

archive=${1:-}
signature=${2:-"${archive}.minisig"}
expected_version=${3:-}
operation_id=${4:-}
test "$(id -u)" -eq 0 || { echo "Run as root" >&2; exit 1; }
test -z "$operation_id" || [[ "$operation_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || { echo "Invalid operation ID" >&2; exit 1; }
test -f "$archive" || { echo "Release archive not found" >&2; exit 1; }
test -f "$signature" || { echo "Release signature not found" >&2; exit 1; }
test -f /opt/outpost/current/infra/release/minisign.pub || { echo "Trusted release public key not found" >&2; exit 1; }
command -v minisign >/dev/null || { echo "minisign is required" >&2; exit 1; }

# The detached signature is verified against the key from the already trusted
# installed release before any archive entry is parsed or extracted.
minisign -Vm "$archive" -x "$signature" -p /opt/outpost/current/infra/release/minisign.pub

update_tmp=$(mktemp -d /var/lib/outpost/update.XXXXXX)
snapshot="/var/lib/outpost/update-snapshots/$(date -u +%Y%m%dT%H%M%SZ).sqlite"
previous=$(readlink -f /opt/outpost/current)
env_file=/etc/outpost/outpost.env
env_previous="$update_tmp/outpost.env.previous"
hysteria_previous="$update_tmp/hysteria.yaml.previous"
xray_previous="$update_tmp/xray.json.previous"
hysteria_was_active=0
xray_was_active=0
next=""
trap 'rm -rf "$update_tmp"' EXIT

mark_operation() {
  test -n "$operation_id" || return 0
  if test "$1" = completed; then
    sqlite3 -cmd '.timeout 5000' /var/lib/outpost/outpost.sqlite \
      "UPDATE operations SET status='completed', progress=100, message='operation.completed', result_json='{\"ok\":true,\"version\":\"$expected_version\"}', error=NULL, updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE id='$operation_id' AND kind='update.apply';"
  else
    sqlite3 -cmd '.timeout 5000' /var/lib/outpost/outpost.sqlite \
      "UPDATE operations SET status='failed', error='Update failed and was rolled back', updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE id='$operation_id' AND kind='update.apply';"
  fi
}

test -f "$env_file" || { echo "Outpost environment not found" >&2; exit 1; }
cp "$env_file" "$env_previous"
cp /etc/outpost/engines/hysteria.yaml "$hysteria_previous"
cp /etc/outpost/engines/xray.json "$xray_previous"
if systemctl is-active --quiet hysteria-server; then hysteria_was_active=1; fi
if systemctl is-active --quiet xray; then xray_was_active=1; fi

tar -xzf "$archive" -C "$update_tmp"
source_dir=$(find "$update_tmp" -mindepth 1 -maxdepth 1 -type d | head -1)
version=$(sed -n 's/.*"version": "\([^"]*\)".*/\1/p' "$source_dir/manifest.json")
[[ "$version" =~ ^[0-9][0-9A-Za-z.-]{0,39}$ ]] || { echo "Invalid release manifest" >&2; exit 1; }
test -z "$expected_version" || test "$version" = "$expected_version" || { echo "Release manifest version does not match requested update" >&2; exit 1; }
(cd "$source_dir" && sha256sum -c SHA256SUMS)
sed "s/^OUTPOST_VERSION=.*/OUTPOST_VERSION=$version/" "$env_file" >"$update_tmp/outpost.env.next"
grep -qxF "OUTPOST_VERSION=$version" "$update_tmp/outpost.env.next"

next="/opt/outpost/releases/$version"
test ! -e "$next" || { echo "Release $version is already installed" >&2; exit 1; }
cp -a "$source_dir" "$next"
install -d -o outpost -g outpost -m 0700 /var/lib/outpost/update-snapshots

systemctl stop outpost
sqlite3 /var/lib/outpost/outpost.sqlite 'PRAGMA wal_checkpoint(TRUNCATE);'
sqlite3 /var/lib/outpost/outpost.sqlite ".backup '$snapshot'"

rollback() {
  ln -sfn "$previous" /opt/outpost/current
  install -o outpost -g outpost -m 0600 "$snapshot" /var/lib/outpost/outpost.sqlite
  install -o root -g outpost -m 0640 "$env_previous" "$env_file"
  install -o root -g outpost -m 0640 "$hysteria_previous" /etc/outpost/engines/hysteria.yaml
  install -o root -g outpost -m 0640 "$xray_previous" /etc/outpost/engines/xray.json
  systemctl daemon-reload
  systemctl restart outpost-agent
  if test "$hysteria_was_active" = 1; then systemctl restart hysteria-server || true; fi
  if test "$xray_was_active" = 1; then systemctl restart xray || true; fi
  mark_operation failed || true
  systemctl restart outpost
  echo "Update failed and was rolled back to $previous" >&2
}
trap 'rollback' ERR

OUTPOST_DATABASE=/var/lib/outpost/outpost.sqlite "$next/bin/outpostctl" migrate
ln -sfn "$next" /opt/outpost/current
install -o root -g outpost -m 0640 "$update_tmp/outpost.env.next" "$env_file"
install -m 0644 "$next"/infra/systemd/*.service /etc/systemd/system/
systemctl daemon-reload
systemctl restart outpost-agent
systemctl is-active --quiet outpost-agent
OUTPOST_RESTART_HYSTERIA="$hysteria_was_active" OUTPOST_RESTART_XRAY="$xray_was_active" \
  /opt/outpost/current/infra/scripts/outpostctl reconcile-engine-presets
systemctl start outpost

for _ in {1..30}; do
  curl -fsS http://127.0.0.1:8181/readyz >/dev/null && break
  sleep 1
done
curl -fsS http://127.0.0.1:8181/readyz >/dev/null
mark_operation completed
trap - ERR

# Keep current plus two previous immutable releases.
find /opt/outpost/releases -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk 'NR>3 {print $2}' | xargs -r rm -rf --
find /var/lib/outpost/update-snapshots -type f -name '*.sqlite' -printf '%T@ %p\n' | sort -nr | awk 'NR>5 {print $2}' | xargs -r rm -f --
rm -f -- "$archive" "$signature"
echo "Updated to $version"
