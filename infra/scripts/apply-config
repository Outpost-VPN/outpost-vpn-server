#!/usr/bin/env bash
set -euo pipefail

source_path=${1:-}
target_path=${2:-}
engine=${3:-}
restart=${4:-1}

case "$restart" in
  0|1|validate-only|sync) ;;
  *) echo "Restart flag is not allowed" >&2; exit 1 ;;
esac

if test "$restart" = validate-only; then
  test "$source_path" = "$target_path" || exit 1
else
case "$source_path:$target_path" in
  /var/lib/outpost/runtime/*:/etc/outpost/engines/*) ;;
  *) echo "Config path is not allowed" >&2; exit 1 ;;
esac
fi

case "$engine:$target_path" in
  xray:/etc/outpost/engines/xray.json)
    service=xray
    /opt/outpost/engines/xray/current/xray run -test -config "$source_path"
    ;;
  hysteria:/etc/outpost/engines/hysteria.yaml)
    service=hysteria-server
    # Hysteria has no validate-only command. The application performs a strict
    # YAML/protected-block check; systemd health decides whether to rollback.
    ;;
  amneziawg:/etc/outpost/engines/amneziawg.json)
    service=outpost-amneziawg
    native=$(mktemp)
    trap 'rm -f "$native"' EXIT
    /opt/outpost/current/bin/outpostctl awg-native "$source_path" >"$native"
    ;;
  mihomo:/etc/outpost/engines/mihomo.yaml)
    service=outpost-mihomo
    if test -x /opt/outpost/engines/mihomo/current/mihomo; then
      /opt/outpost/engines/mihomo/current/mihomo -t -f "$source_path" -d /var/lib/outpost/mihomo
    else
      test "$restart" = 0 || exit 1
    fi
    ;;
  sing-box:/etc/outpost/engines/sing-box.json)
    service=outpost-sing-box
    if test -x /opt/outpost/engines/sing-box/current/sing-box; then
      /opt/outpost/engines/sing-box/current/sing-box check -c "$source_path"
    else
      test "$restart" = 0 || exit 1
    fi
    ;;
  *) echo "Engine target is not allowed" >&2; exit 1 ;;
esac

if test "$restart" = validate-only; then exit 0; fi
if cmp -s "$source_path" "$target_path"; then exit 0; fi
backup_path="${target_path}.previous"
had_target=0
was_active=0
if test -f "$target_path"; then had_target=1; cp -a "$target_path" "$backup_path"; fi
if systemctl is-active --quiet "$service"; then was_active=1; fi
restore_config() {
  if test "$had_target" = 1; then cp -a "$backup_path" "$target_path"; else rm -f "$target_path"; fi
  if test "$was_active" = 1; then systemctl restart "$service" || true; fi
  /opt/outpost/current/infra/scripts/engine-firewall "$engine" || true
}
install -o root -g outpost -m 0640 "$source_path" "${target_path}.tmp"
mv "${target_path}.tmp" "$target_path"

if test -d "/opt/outpost/engines/$engine/current"; then
  /opt/outpost/current/infra/scripts/engine-firewall "$engine" || { restore_config; exit 1; }
fi

if test "$restart" = 0; then
  echo "Configuration validated and installed; inactive engine was not started"
  exit 0
fi

if test "$engine" = amneziawg && test "$restart" = sync; then
  if /opt/outpost/engines/amneziawg/current/awg syncconf outpost-awg "$native"; then exit 0; fi
  restore_config
  echo "AmneziaWG peer synchronization failed" >&2
  exit 1
fi
if ! systemctl restart "$service"; then
  restore_config
  echo "Engine rejected the configuration; previous revision restored" >&2
  exit 1
fi

/opt/outpost/current/infra/scripts/engine-health "$engine" || {
  restore_config
  echo "Engine did not become active; previous revision restored" >&2
  exit 1
}
