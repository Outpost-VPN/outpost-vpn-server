#!/usr/bin/env bash
set -euo pipefail

release_archive=${1:-}
release_signature=${2:-"${release_archive}.minisig"}
release_public_key="RWQIi2TPWGnwEuL3XnEdwUYwcd194z3YYWM3sDdZNMhfEPf5xsFAk1FY"
certbot=/snap/bin/certbot
acme_webroot=/var/www/outpost-acme
release_tmp=
version=
public_ip=
rollback_armed=0
ufw_was_active=0

install_certbot_snap() {
  local attempt
  for attempt in 1 2 3; do
    if snap install --classic certbot; then
      return 0
    fi
    if test "$attempt" -lt 3; then
      echo "Certbot snap installation was interrupted; retrying after snapd settles" >&2
      snap wait system seed.loaded >/dev/null 2>&1 || true
      sleep 5
    fi
  done
  return 1
}

rollback_install() {
  echo "Installation failed; rolling back Outpost files and services" >&2
  systemctl disable --now outpost outpost-agent xray hysteria-server >/dev/null 2>&1 || true
  if test -n "$public_ip" && test -x "$certbot"; then
    "$certbot" delete --non-interactive --cert-name "$public_ip" >/dev/null 2>&1 || true
  fi
  systemctl stop nginx >/dev/null 2>&1 || true
  rm -f /etc/nginx/sites-enabled/outpost /etc/nginx/sites-available/outpost
  if test -f /etc/nginx/sites-available/default; then
    ln -sfn /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
  fi
  rm -f /etc/letsencrypt/renewal-hooks/deploy/outpost /usr/local/bin/outpostctl
  rm -f /etc/systemd/system/outpost.service /etc/systemd/system/outpost-agent.service
  rm -f /etc/systemd/system/xray.service /etc/systemd/system/hysteria-server.service
  rm -rf /opt/outpost /etc/outpost /var/lib/outpost "$acme_webroot"
  if test "$ufw_was_active" -eq 0; then
    ufw --force disable >/dev/null 2>&1 || true
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
}

finish() {
  status=$?
  set +e
  if test "$rollback_armed" -eq 1; then
    rollback_install
  fi
  if test -n "$release_tmp"; then
    rm -rf "$release_tmp"
  fi
  trap - EXIT
  exit "$status"
}

trap finish EXIT

test "$(id -u)" -eq 0 || { echo "Run as root" >&2; exit 1; }
test -f "$release_archive" || { echo "Release archive not found" >&2; exit 1; }
test -f "$release_signature" || { echo "Release signature not found" >&2; exit 1; }
test "$(dpkg --print-architecture)" = "amd64" || { echo "Ubuntu amd64 is required" >&2; exit 1; }
# shellcheck source=/dev/null
. /etc/os-release
if test "$ID" != "ubuntu" || test "$VERSION_ID" != "24.04"; then
  echo "Ubuntu 24.04 is required" >&2
  exit 1
fi

if ss -Hlnptu | awk '{print $5}' | grep -Eq ':(80|443)$'; then
  echo "Ports 80 or 443 are already occupied; a clean Ubuntu install is required" >&2
  exit 1
fi

public_ip=$(curl -4fsS --max-time 10 https://api.ipify.org)
[[ "$public_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo "Could not detect the public IPv4" >&2; exit 1; }
if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -Fx "Status: active" >/dev/null; then
  ufw_was_active=1
fi
if test -e /opt/outpost/current || test -e /etc/outpost/outpost.env; then
  echo "An existing Outpost installation was found" >&2
  exit 1
fi
rollback_armed=1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends nginx snapd ufw unzip curl ca-certificates age sqlite3 minisign openssl
systemctl enable --now snapd.socket
snap wait system seed.loaded
snap install core >/dev/null 2>&1 || snap refresh core >/dev/null
if ! test -x "$certbot"; then
  install_certbot_snap
else
  snap refresh certbot >/dev/null || true
fi
certbot_version=$($certbot --version | awk '{print $2}')
dpkg --compare-versions "$certbot_version" ge 5.4 || { echo "Certbot 5.4 or newer is required" >&2; exit 1; }

# Verify the detached signature before parsing or extracting any archive entry.
minisign -Vm "$release_archive" -x "$release_signature" -P "$release_public_key"

release_tmp=$(mktemp -d)
tar -xzf "$release_archive" -C "$release_tmp"
release_dir=$(find "$release_tmp" -mindepth 1 -maxdepth 1 -type d -name 'outpost-*' -print -quit)
if test -z "$release_dir" || ! test -f "$release_dir/manifest.json"; then
  echo "Invalid release archive" >&2
  exit 1
fi
version=$(sed -n 's/.*"version": "\([^"]*\)".*/\1/p' "$release_dir/manifest.json")
if test -z "$version" || test "$(basename "$release_dir")" != "outpost-$version"; then
  echo "Invalid release manifest" >&2
  exit 1
fi
(cd "$release_dir" && sha256sum -c SHA256SUMS)

id outpost >/dev/null 2>&1 || useradd --system --home /var/lib/outpost --shell /usr/sbin/nologin outpost
install -d -o root -g root -m 0755 /opt/outpost/releases /opt/outpost/engines
install -d -o outpost -g outpost -m 0700 /var/lib/outpost /var/lib/outpost/incoming /var/lib/outpost/runtime
install -d -o root -g root -m 0755 "$acme_webroot"
install -d -o root -g outpost -m 0750 /etc/outpost /etc/outpost/engines

test ! -e "/opt/outpost/releases/$version" || { echo "Release $version already exists" >&2; exit 1; }
cp -a "$release_dir" "/opt/outpost/releases/$version"
ln -sfn "/opt/outpost/releases/$version" /opt/outpost/current

xhttp_path="/$(openssl rand -hex 18)"
grpc_service="$(openssl rand -hex 18)"
stats_secret=$(openssl rand -hex 24)
admin_path=/admin

sed -e "s|__DOMAIN__|$public_ip|g" -e "s|__STATS_SECRET__|$stats_secret|g" \
  /opt/outpost/current/infra/config/hysteria.yaml.template >/etc/outpost/engines/hysteria.yaml
sed -e "s|__XHTTP_PATH__|$xhttp_path|g" -e "s|__GRPC_SERVICE__|$grpc_service|g" \
  /opt/outpost/current/infra/config/xray.json.template >/etc/outpost/engines/xray.json
cat >/etc/outpost/outpost.env <<ENV
NODE_ENV=production
OUTPOST_VERSION=$version
OUTPOST_SETUP=1
OUTPOST_PUBLIC_IP=$public_ip
OUTPOST_DOMAIN=$public_ip
OUTPOST_RP_ID=$public_ip
OUTPOST_ORIGIN=https://$public_ip
OUTPOST_ADMIN_PATH=$admin_path
OUTPOST_XHTTP_PATH=$xhttp_path
OUTPOST_GRPC_SERVICE=$grpc_service
OUTPOST_LISTEN=127.0.0.1:8181
OUTPOST_DATA_DIR=/var/lib/outpost
OUTPOST_CONFIG_DIR=/etc/outpost
OUTPOST_WEB_ROOT=/opt/outpost/current/public
OUTPOST_HYSTERIA_STATS_URL=http://127.0.0.1:9999
OUTPOST_HYSTERIA_STATS_SECRET=$stats_secret
OUTPOST_XRAY_BINARY=/opt/outpost/engines/xray/current/xray
OUTPOST_XRAY_API=127.0.0.1:10085
ENV
chmod 0640 /etc/outpost/outpost.env /etc/outpost/engines/*
chown root:outpost /etc/outpost/outpost.env /etc/outpost/engines/*

systemctl stop nginx
install -m 0644 /opt/outpost/current/infra/nginx/outpost-setup-http.conf.template /etc/nginx/sites-available/outpost
ln -sfn /etc/nginx/sites-available/outpost /etc/nginx/sites-enabled/outpost
rm -f /etc/nginx/sites-enabled/default
install -d -o root -g root -m 0755 "$acme_webroot/.well-known/acme-challenge"
printf 'outpost-acme-ok\n' >"$acme_webroot/.well-known/acme-challenge/outpost-probe"
chmod 0644 "$acme_webroot/.well-known/acme-challenge/outpost-probe"
nginx -t
systemctl enable nginx
systemctl start nginx
test "$(curl -fsS -H "Host: $public_ip" http://127.0.0.1/.well-known/acme-challenge/outpost-probe)" = "outpost-acme-ok"
rm -f "$acme_webroot/.well-known/acme-challenge/outpost-probe"

"$certbot" certonly \
  --non-interactive \
  --agree-tos \
  --register-unsafely-without-email \
  --preferred-profile shortlived \
  --webroot \
  --webroot-path "$acme_webroot" \
  --cert-name "$public_ip" \
  --ip-address "$public_ip"

sed -e "s|__PUBLIC_IP__|$public_ip|g" \
  /opt/outpost/current/infra/nginx/outpost-setup.conf.template >/etc/nginx/sites-available/outpost
install -m 0755 /opt/outpost/current/infra/renewal-hooks/deploy/outpost /etc/letsencrypt/renewal-hooks/deploy/outpost
nginx -t
systemctl reload nginx

/opt/outpost/current/infra/scripts/install-engines
install -m 0644 /opt/outpost/current/infra/systemd/*.service /etc/systemd/system/
install -m 0755 /opt/outpost/current/infra/scripts/outpostctl /usr/local/bin/outpostctl
systemctl daemon-reload
ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw allow 443/udp
ufw --force enable
systemctl enable --now nginx outpost-agent outpost

for _ in {1..30}; do
  curl -fsS http://127.0.0.1:8181/readyz >/dev/null && break
  sleep 1
done
curl -fsS http://127.0.0.1:8181/readyz >/dev/null
rollback_armed=0

echo
echo "https://$public_ip/"
