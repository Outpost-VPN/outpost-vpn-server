MATRESHKA_DOMAIN=proxy.example.com
MATRESHKA_ADMIN_PATH=/admin
MATRESHKA_DATA_DIR=/var/lib/matreshka
MATRESHKA_CONFIG_DIR=/etc/matreshka
MATRESHKA_LISTEN=127.0.0.1:8181
MATRESHKA_RP_ID=proxy.example.com
MATRESHKA_ORIGIN=https://proxy.example.com
MATRESHKA_XHTTP_PATH=/xhttp-change-me
MATRESHKA_DEMO=0
